# ── App ──
PORT=3000

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idea_prioritizer
DB_USER=postgres
DB_PASSWORD=postgres

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT (RS256) ──
# Generate a keypair: openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#                     openssl rsa -pubout -in private.pem -out public.pem
# Then base64-encode and paste here, or mount as files.
JWT_PRIVATE_KEY=base64-encoded-private-key
JWT_PUBLIC_KEY=base64-encoded-public-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── OAuth: Google ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── OAuth: GitHub ──
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ── Scoring ──
SCORE_WEIGHT_FIT=0.5
SCORE_WEIGHT_EFFORT=0.3
SCORE_WEIGHT_NOVELTY=0.2

# ── Rate Limit ──
IDEA_DAILY_LIMIT=2
