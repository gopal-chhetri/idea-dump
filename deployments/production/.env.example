# ── App ──
PORT=3000
DOMAIN=ideas.soylab.dpdns.org
FRONTEND_URL=https://ideas.soylab.dpdns.org/app

# ── Database ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=idea_dump
DB_USER=postgres
DB_PASS=change-me

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT (RS256) ──
# Base64-encoded PEM keypair (same as local .env)
JWT_PRIVATE_KEY=base64-encoded-private-key
JWT_PUBLIC_KEY=base64-encoded-public-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Encryption (for admin settings at rest) ──
APP_ENCRYPTION_KEY=change-me-to-a-secure-random-string

# ── OAuth: Google ──
# The OAuth App's callback URL (one of /auth/google/callback or
# /api/auth/google/callback) is used; no *_CALLBACK_URL env var is read.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Scoring ──
SCORE_WEIGHT_FIT=0.5
SCORE_WEIGHT_EFFORT=0.3
SCORE_WEIGHT_NOVELTY=0.2

# ── Rate Limit ──
IDEA_DAILY_LIMIT=2

# ── Registry ──
REGISTRY_OWNER=gopal-chhetri
IMAGE_TAG=latest

# ── Infisical ──
INFISICAL_IDENTITY_ID=
INFISICAL_PROJECT_SLUG=
INFISICAL_PROJECT_ID=

# ── VPS ──
VPS_HOST=
VPS_SSH_USER=
VPS_SSH_KEY=
